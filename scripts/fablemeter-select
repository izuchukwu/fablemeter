#!/usr/bin/env python3
"""Explicit user selection from the menu; reuse the CLI's verified swap API.

The CLI's agent entry point is reserved for Icon. A person clicking the menu
is logged as the user, without impersonating an agent. Preserve its locks,
credential preflight, backups, readback, Personal guard and audit log.

The app passes the clicked row's Anthropic account UUID, never its display
label: the app's labels are editable and are not the CLI's, so a label could
name a different saved account, and the CLI's own resolver also matches
nicknames. The UUID alone picks the CLI's key, under the swap lock, and an id
the CLI does not hold exactly once is refused before anything moves.
"""
import os
import runpy
import sys
import uuid as uuidlib


def by_uuid(meta, want):
    """The one saved key holding `want`, or None. Keys and nicknames are never
    consulted: a nickname can collide with another row's key."""
    hits = [k for k, v in meta.items() if str(v.get("accountUuid", "")).lower() == want]
    return hits[0] if len(hits) == 1 else None


def selftest():
    a, b = "11111111-1111-4111-8111-111111111111", "22222222-2222-4222-8222-222222222222"
    meta = {"C": {"nickname": "P", "accountUuid": b}, "P": {"nickname": "Personal", "accountUuid": a}}
    checks = [
        ("a nickname equal to another key does not capture its UUID", by_uuid(meta, a) == "P"),
        ("the colliding row still resolves by its own UUID", by_uuid(meta, b) == "C"),
        ("an unknown UUID resolves to nothing", by_uuid(meta, "33333333-3333-4333-8333-333333333333") is None),
        ("a UUID on two keys resolves to nothing", by_uuid({"A": {"accountUuid": a}, "B": {"accountUuid": a}}, a) is None),
        ("UUID case does not matter", by_uuid({"A": {"accountUuid": a.upper()}}, a) == "A"),
    ]
    for name, ok in checks:
        print(("PASS  " if ok else "FAIL  ") + "select: " + name)
    return 0 if all(ok for _, ok in checks) else 1


def main():
    if sys.argv[1:] == ["--selftest"]:
        return selftest()
    if len(sys.argv) != 2 or not sys.argv[1].strip():
        print("Choose an account in Fablemeter.", file=sys.stderr)
        return 1
    try:
        want = str(uuidlib.UUID(sys.argv[1].strip())).lower()
    except ValueError:
        print("Fablemeter does not know which account this row is.", file=sys.stderr)
        return 1
    api = runpy.run_path(os.path.expanduser("~/.claude/bin/fablemeter"))
    swap_to = api["swap_to"]
    # swap_to resolves its target under its own lock, from freshly loaded
    # metadata, through the module-level _resolve_label. Bind that lookup to
    # the UUID so the target is decided there, under the lock, and nothing
    # but the UUID can choose it. run_path hands back a copy of the globals,
    # so the patch goes on the function's own.
    swap_to.__globals__["_resolve_label"] = lambda _ctx, meta, _want: by_uuid(meta, want)
    try:
        return swap_to(
            api["real_ctx"](), want, who="user: Fablemeter menu",
            why="User explicitly selected this account in Fablemeter",
            personal_first=True, cooldown_min=0,
        )
    except api["SwapError"] as error:
        message = str(error)
        if "is not a saved account" in message:
            message = "This account is not saved for switching on this Mac. Enroll it with fablemeter swap --enroll."
        print(message, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
